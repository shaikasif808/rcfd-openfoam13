FoamFile
{
    format      ascii;
    class       dictionary;
    object      createNonConformalCouplesDict;
}

fields  yes;

nonConformalCouples
{
    sidesX
    {
        patches         (left right);
        transform       translational;
        separation      (-0.01 0 0);
    }
    sidesY
    {
        patches         (top bottom);
        transform       translational;
        separation      (0 0.01 0);
    }
}

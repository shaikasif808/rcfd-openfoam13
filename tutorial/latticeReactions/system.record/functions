rCFDPrep1
{
    type            rCFDPrep;
    libs            ("librCFDFunctionObjects.so");

    phases          (fluid);
    fields
    {
        fluid { alpha none; flux phi; rho none; }
    }

    recordStart     0.02;               // s
    writeFields     yes;

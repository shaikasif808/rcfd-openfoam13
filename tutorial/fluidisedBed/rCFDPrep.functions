
// rCFD preparation mode during the run (counterpart of rcfd_prep.scm).
// Frame interval, number of frames and all rCFD settings: rCFD/rCFD_user_prep.h
rCFDPrep1
{
    type            rCFDPrep;
    libs            ("librCFDFunctionObjects.so");

    phases          (air particles);    // order = phase index in the user headers
    recordStart     2.0;                // s, end of the spin-up

    // further databases of the same recording with other frame intervals, each in its own
    // folder db_<ms>ms/data (release r7); multiples of the frame interval of the header
    // extraFrameIntervals (0.010 0.015 0.020 0.025);
}

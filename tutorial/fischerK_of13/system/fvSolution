FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.05;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }

    // position labels of the rCFD recording (job 2)
    "rCFD.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }
}

// The solver modules of OpenFOAM-13 read their controls from PIMPLE, also for a steady
// case: the run stops when the initial residuals fall below residualControl.
PIMPLE
{
    nNonOrthogonalCorrectors 1;

    residualControl
    {
        p               1e-5;
        U               1e-6;
    }

    pRefCell        0;
    pRefValue       0;
}

relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
    }
}


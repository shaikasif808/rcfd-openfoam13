FoamFile
{
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// used by job1_flow.sbatch if this OpenFOAM build has no scotch library

numberOfSubdomains 64;

method          hierarchical;

hierarchicalCoeffs
{
    n               (4 4 4);
    order           xyz;
}


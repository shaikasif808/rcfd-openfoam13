FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (particles air);

referencePhase  air;

particles
{
    type            pureIsothermalPhaseModel;

    diameterModel   constant;
    constantCoeffs
    {
        d               0.0018;
    }

    alphaMax        0.62;
    residualAlpha   1e-6;
}

air
{
    type            pureIsothermalPhaseModel;

    diameterModel   none;

    residualAlpha   0;
}

blending
{
    default
    {
        type            continuous;
        phase           air;
    }
}

surfaceTension
{}


FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    casing
    {
        type            zeroGradient;
    }

    nozzle_inlet
    {
        type            zeroGradient;
    }
	
	nozzle_wall
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //

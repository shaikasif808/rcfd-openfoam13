FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
#include		"../BCDict"
internalField   uniform (0 $Uy 0);

boundaryField
{
    inlet
    {
        type            interstitialInletVelocity;
        inletVelocity   uniform (0 $Uy 0);
        alpha           alpha.air;
        value           $internalField;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.air;
        value           $internalField;
    }

    casing
    {
        type            noSlip;
    }

    nozzle_inlet
    {
        type            interstitialInletVelocity;
        inletVelocity   uniform (0 $U_nozzle 0);
        alpha           alpha.air;
        value           $internalField;
    }
	
	nozzle_wall
    {
        type            noSlip;
    }
}

// ************************************************************************* //

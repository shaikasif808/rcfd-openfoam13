FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Theta.particles;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 2 -2 0 0 0 0];

internalField       uniform 0;

referenceLevel      1e-4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-4;
    }

    outlet
    {
        type            zeroGradient;
    }

    casing
    {
        type            JohnsonJacksonParticleTheta;
        restitutionCoefficient 0.75;
        specularityCoefficient 0.01;
        value           uniform 1e-4;
    }
	
    nozzle_inlet
    {
        type            fixedValue;
        value           uniform 1e-4;
    }
	
	nozzle_wall
    {
        type            JohnsonJacksonParticleTheta;
        restitutionCoefficient 0.75;
        specularityCoefficient 0.01;
        value           uniform 1e-4;
    }
}

// ************************************************************************* //

FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          multiphaseEuler;

libs            ("libGF25Drag.so");

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20.001;     // 5 s start-up + 2000 frames of 5 ms (database complete at 15 s)

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.5;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable on;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       2e-4;

// ************************************************************************* //

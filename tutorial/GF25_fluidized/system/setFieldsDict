FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    alpha.air       1;
    alpha.particles 0;
}

zones
{
    bed
    {
        type        box;

        box         (-1 0 -1) (1 0.15 2);    // 11 layers of 10 mm cells above the inlet (y = 0.04): 0.027391 m3

        values
        {
            alpha.air       0.4734;
            alpha.particles 0.5266;   // 15 kg / (1040 kg/m3 * 0.027391 m3)
        }
    }
}



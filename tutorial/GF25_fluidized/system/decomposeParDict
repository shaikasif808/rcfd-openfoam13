FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  32;

method              hierarchical;

hierarchicalCoeffs
{
    n               (2 1 16);     // x z: the trough is 1 m long in z; no cut in y (bed height)
    order           xyz;
}



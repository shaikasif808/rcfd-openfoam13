FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// averages from the end of the start-up
#includeFunc fieldAverage(U.particles, U.air, alpha.particles, p, startTime=5)

// monitors (postProcessing/): solids volume [m3] (x 1040 = bed mass in kg),
// pressure under the bed (minus 1e5 = bed pressure drop), densest cell
#includeFunc volIntegrate(alpha.particles)
#includeFunc patchAverage(patch=inlet, fields=(p))
#includeFunc cellMax(alpha.particles)

// rCFD database: frame interval and number of frames are in rCFD/rCFD_user_prep.h
rCFDPrep1
{
    type            rCFDPrep;
    libs            ("librCFDFunctionObjects.so");

    phases          (air particles);    // order = phase index in the user headers
    recordStart     10;                  // s, after the start-up
}

